DirectoryIndex index.php

Options -Indexes

RewriteEngine On

RewriteRule ^config(?:/|$) - [F,L]
RewriteRule ^src(?:/|$) - [F,L]

RewriteRule ^\.git(?:/|$) - [F,L]

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "^(schema\.sql|compose\.yaml|Dockerfile|README\.md)$">
    Require all denied
</FilesMatch>

ErrorDocument 404 /404.php